        {
          "name": "experiment_id",
          "column_type": "string",
          "nullable": true,
          "description": "Experiment the score belongs to."
        },
        {
          "name": "dataset_item_id",
          "column_type": "string",
          "nullable": true,
          "description": "Dataset item the score belongs to."
        },
        {
          "name": "author_user_id",
          "column_type": "string",
          "nullable": true,
          "description": "Person who annotated, for human scores."
