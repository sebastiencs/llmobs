{
  "views": [
    {
      "name": "traces",
      "description": "One row per trace. Merge bookkeeping columns are not exposed.",
      "columns": [
        {
          "name": "trace_id",
          "column_type": "string",
          "nullable": false,
          "description": "Trace id, 16 bytes as lowercase hex."
        },
        {
          "name": "start_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Earliest span start."
        },
        {
          "name": "end_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Latest span end."
        },
        {
          "name": "duration_ns",
          "column_type": "integer",
          "nullable": false,
          "description": "end_time minus start_time, in nanoseconds."
        },
        {
          "name": "duration_ms",
          "column_type": "float",
          "nullable": false,
          "description": "duration_ns / 1e6, for convenience."
        },
        {
          "name": "name",
          "column_type": "string",
          "nullable": true,
          "description": "Name of the root span, else the earliest span."
        },
        {
          "name": "root_span_id",
          "column_type": "string",
          "nullable": true,
          "description": "Span id of the root. Null when the trace has no root."
        },
        {
          "name": "has_root",
          "column_type": "boolean",
          "nullable": false,
          "description": "Whether a root span is present."
        },
        {
          "name": "status",
          "column_type": "string",
          "nullable": false,
          "description": "error if any span errored, else the root status, else unset."
        },
        {
          "name": "session_id",
          "column_type": "string",
          "nullable": true,
          "description": "Session id, preferring the root."
        },
        {
          "name": "user_id",
          "column_type": "string",
          "nullable": true,
          "description": "End-user id, preferring the root."
        },
        {
          "name": "environment",
          "column_type": "string",
          "nullable": true,
          "description": "Deployment environment."
        },
        {
          "name": "release",
          "column_type": "string",
          "nullable": true,
          "description": "Git SHA or version string."
        },
        {
          "name": "tags",
          "column_type": "string_list",
          "nullable": false,
          "description": "Distinct union of span tags."
        },
        {
          "name": "metadata",
          "column_type": "string_map",
          "nullable": false,
          "description": "Root metadata, with keys from other spans added when absent."
        },
        {
          "name": "input_preview",
          "column_type": "string",
          "nullable": true,
          "description": "Root input preview, else the first llm span's."
        },
        {
          "name": "output_preview",
          "column_type": "string",
          "nullable": true,
          "description": "Root output preview, else the first llm span's."
        },
        {
          "name": "span_count",
          "column_type": "integer",
          "nullable": false,
          "description": "Number of spans."
        },
        {
          "name": "error_count",
          "column_type": "integer",
          "nullable": false,
          "description": "Number of spans with status error."
        },
        {
          "name": "llm_count",
          "column_type": "integer",
          "nullable": false,
          "description": "Number of llm spans."
        },
        {
          "name": "input_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of input tokens. Null when every span omitted the field."
        },
        {
          "name": "output_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of output tokens. Null when every span omitted the field."
        },
        {
          "name": "cache_read_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of cache-read tokens. Null when every span omitted the field."
        },
        {
          "name": "cache_write_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of cache-write tokens. Null when every span omitted the field."
        },
        {
          "name": "reasoning_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of reasoning tokens. Null when every span omitted the field."
        },
        {
          "name": "total_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Sum of total tokens. Null when every span omitted the field."
        },
        {
          "name": "cost_total",
          "column_type": "float",
          "nullable": true,
          "description": "Sum of span costs, USD. Null when every span omitted the field."
        },
        {
          "name": "models",
          "column_type": "string_list",
          "nullable": false,
          "description": "Distinct model names."
        }
      ]
    },
    {
      "name": "spans",
