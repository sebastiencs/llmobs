          "nullable": true,
          "description": "Sum of trace total tokens."
        },
        {
          "name": "cost_total",
          "column_type": "float",
          "nullable": true,
          "description": "Sum of trace costs, USD."
        },
        {
          "name": "user_id",
          "column_type": "string",
          "nullable": true,
          "description": "End-user id of the session."
        },
        {
          "name": "tags",
          "column_type": "string_list",
          "nullable": false,
          "description": "Distinct union of trace tags."
        }
      ]
    },
    {
      "name": "scores",
      "description": "One row per live score.",
      "columns": [
        {
          "name": "score_id",
          "column_type": "string",
          "nullable": false,
          "description": "Score id."
        },
        {
          "name": "target",
          "column_type": "string",
          "nullable": false,
          "description": "span, trace, or session."
        },
        {
          "name": "trace_id",
          "column_type": "string",
          "nullable": true,
          "description": "Trace id for a span or trace target."
        },
        {
          "name": "span_id",
          "column_type": "string",
          "nullable": true,
          "description": "Span id for a span target."
        },
        {
          "name": "session_id",
          "column_type": "string",
          "nullable": true,
          "description": "Session id for a session target, and copied for a trace target when known."
        },
        {
          "name": "user_id",
          "column_type": "string",
          "nullable": true,
          "description": "End-user id, when the writer knew it."
        },
        {
          "name": "name",
          "column_type": "string",
          "nullable": false,
          "description": "Score name."
        },
        {
          "name": "data_type",
