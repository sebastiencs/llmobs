          "nullable": false,
          "description": "Session id."
        },
        {
          "name": "start_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Earliest trace start."
        },
        {
          "name": "end_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Latest trace end."
        },
        {
          "name": "duration_ns",
          "column_type": "integer",
          "nullable": false,
