          "description": "Trace id, 16 bytes as lowercase hex."
        },
        {
          "name": "span_id",
          "column_type": "string",
          "nullable": false,
          "description": "Span id, 8 bytes as lowercase hex."
        },
        {
          "name": "parent_span_id",
          "column_type": "string",
          "nullable": true,
          "description": "Parent span id. Null when the span was received as a root."
        },
        {
          "name": "name",
          "column_type": "string",
          "nullable": false,
          "description": "Span name."
        },
        {
          "name": "span_kind",
          "column_type": "string",
          "nullable": false,
          "description": "Kind of work: llm, embedding, tool, agent, chain, retriever, reranker, guardrail, evaluator, or span."
        },
        {
          "name": "start_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Start time."
        },
        {
          "name": "end_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "End time."
        },
        {
          "name": "duration_ns",
          "column_type": "integer",
          "nullable": false,
          "description": "end_time minus start_time, in nanoseconds."
        },
        {
          "name": "duration_ms",
          "column_type": "float",
          "nullable": false,
          "description": "duration_ns / 1e6, for convenience."
        },
        {
          "name": "status",
          "column_type": "string",
          "nullable": false,
          "description": "unset, ok, or error."
        },
        {
          "name": "status_message",
          "column_type": "string",
          "nullable": true,
          "description": "Status description."
        },
        {
          "name": "service_name",
          "column_type": "string",
          "nullable": true,
          "description": "Resource service.name."
        },
        {
          "name": "session_id",
          "column_type": "string",
          "nullable": true,
          "description": "Session id."
        },
        {
          "name": "user_id",
          "column_type": "string",
          "nullable": true,
          "description": "End-user id."
        },
        {
          "name": "environment",
          "column_type": "string",
          "nullable": true,
          "description": "Deployment environment. llmobs-eval is reserved for evaluator runs."
        },
        {
          "name": "release",
          "column_type": "string",
          "nullable": true,
          "description": "Git SHA or version string."
        },
        {
          "name": "tags",
          "column_type": "string_list",
          "nullable": false,
          "description": "Tags."
        },
        {
          "name": "metadata",
          "column_type": "string_map",
          "nullable": false,
          "description": "User metadata. Values are JSON-encoded scalars or strings."
        },
        {
          "name": "provider",
          "column_type": "string",
          "nullable": true,
          "description": "Normalized provider name, for example openai or anthropic."
        },
        {
          "name": "request_model",
          "column_type": "string",
          "nullable": true,
          "description": "Model named in the request."
        },
        {
          "name": "response_model",
          "column_type": "string",
          "nullable": true,
          "description": "Model named in the response."
        },
        {
          "name": "model",
          "column_type": "string",
          "nullable": true,
          "description": "coalesce(response_model, request_model)."
        },
        {
          "name": "operation",
          "column_type": "string",
          "nullable": true,
          "description": "GenAI operation name."
        },
        {
          "name": "input_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Input tokens, including cached tokens."
        },
        {
          "name": "output_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Output tokens, including reasoning tokens."
        },
        {
          "name": "cache_read_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Cache-read tokens."
        },
        {
          "name": "cache_write_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Cache-write tokens."
        },
        {
          "name": "reasoning_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Reasoning tokens."
        },
        {
          "name": "total_tokens",
          "column_type": "integer",
          "nullable": true,
          "description": "Total tokens."
        },
        {
          "name": "cost_input",
          "column_type": "float",
          "nullable": true,
          "description": "Input cost, USD."
        },
        {
          "name": "cost_output",
          "column_type": "float",
          "nullable": true,
          "description": "Output cost, USD."
        },
        {
          "name": "cost_total",
          "column_type": "float",
          "nullable": true,
          "description": "Total cost, USD, including cache and reasoning."
        },
        {
          "name": "cost_source",
          "column_type": "string",
          "nullable": true,
          "description": "computed, reported, or none."
        },
        {
          "name": "ttft_ns",
          "column_type": "integer",
          "nullable": true,
          "description": "Time to first token, nanoseconds."
        },
        {
          "name": "request_params",
          "column_type": "json",
          "nullable": true,
          "description": "Request parameters such as temperature and max_tokens."
        },
        {
          "name": "input",
          "column_type": "string",
          "nullable": true,
          "description": "Stored payload text."
        },
        {
          "name": "input_format",
          "column_type": "string",
          "nullable": true,
          "description": "messages, json, or text."
        },
        {
          "name": "output",
          "column_type": "string",
          "nullable": true,
          "description": "Stored payload text."
        },
        {
          "name": "output_format",
          "column_type": "string",
          "nullable": true,
          "description": "messages, json, or text."
        },
        {
          "name": "input_preview",
          "column_type": "string",
          "nullable": true,
          "description": "First 512 characters of the plain-text rendering."
        },
        {
          "name": "output_preview",
          "column_type": "string",
          "nullable": true,
          "description": "First 512 characters of the plain-text rendering."
        },
        {
          "name": "system_instructions",
          "column_type": "json",
          "nullable": true,
          "description": "System instructions as JSON text."
        },
        {
          "name": "tool_definitions",
          "column_type": "json",
          "nullable": true,
          "description": "Tool definitions as JSON text."
        },
        {
          "name": "attributes",
          "column_type": "string_map",
          "nullable": false,
          "description": "Span attributes not consumed by normalization. Values are JSON-encoded."
        },
        {
          "name": "resource_attributes",
          "column_type": "string_map",
          "nullable": false,
          "description": "Resource attributes except service.name. Values are JSON-encoded."
        },
        {
          "name": "scope_name",
          "column_type": "string",
          "nullable": true,
          "description": "Instrumentation scope name."
        },
        {
          "name": "scope_version",
          "column_type": "string",
          "nullable": true,
          "description": "Instrumentation scope version."
        },
        {
          "name": "events",
          "column_type": "json",
          "nullable": false,
          "description": "Span events. Each item has time, name, and attributes."
        },
        {
          "name": "links",
          "column_type": "json",
          "nullable": false,
          "description": "Span links. Each item has trace_id, span_id, and attributes."
        },
        {
          "name": "media_refs",
          "column_type": "string_list",
          "nullable": false,
          "description": "SHA-256 hex of extracted media blobs."
        },
        {
          "name": "truncated",
          "column_type": "string_list",
          "nullable": false,
          "description": "Names of attributes truncated at ingest."
        },
        {
          "name": "conventions",
          "column_type": "string_list",
          "nullable": false,
          "description": "Detected conventions, for example genai or openinference."
        },
        {
          "name": "ingest_time",
          "column_type": "timestamp",
          "nullable": false,
          "description": "Server receive time."
        },
        {
          "name": "schema_version",
          "column_type": "integer",
          "nullable": false,
          "description": "Row-level normalization version."
        }
      ]
    },
    {
      "name": "sessions",
      "description": "One row per session.",
      "columns": [
        {
          "name": "session_id",
