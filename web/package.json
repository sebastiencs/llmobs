{
  "name": "@llmobs/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "vite build",
    "check": "pnpm check:api && biome check . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
