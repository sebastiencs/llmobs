{
  "name": "@llmobs/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --mode server",
    "gen:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../crates/server/openapi.json -o src/api/schema.gen.ts --check",
    "gen:routes": "tsr generate",
    "typecheck": "pnpm gen:routes && tsc -b",
    "test": "pnpm gen:routes && vitest run",
    "build": "vite build",
    "check": "pnpm check:api && biome check . && pnpm typecheck && pnpm test && pnpm build && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.67.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.17.0",
    "recharts": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "msw"
    ]
  }
}
