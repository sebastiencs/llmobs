{
  "name": "llmobs",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for llmobs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsdown",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
