{
  "name": "llmobs",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK for llmobs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm build && pnpm check:package"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@arizeai/openinference-instrumentation-anthropic": "1.0.0",
    "@arizeai/openinference-instrumentation-langchain": "4.1.5",
    "@arizeai/openinference-instrumentation-openai": "4.4.3",
    "@langchain/core": "1.3.4",
    "@opentelemetry/api": "1.9.1",
    "@types/node": "26.6.6",
    "openai": "7.50.0",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/otlp-transformer": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@arizeai/openinference-instrumentation-anthropic": "^1.0.0",
    "@arizeai/openinference-instrumentation-langchain": "^4.1.5",
    "@arizeai/openinference-instrumentation-openai": "^4.4.3",
    "@langchain/core": "^1.0.0",
    "@opentelemetry/api": ">=1.9.0 <1.10.0",
    "openai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-anthropic": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-langchain": {
      "optional": true
    },
    "@arizeai/openinference-instrumentation-openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
